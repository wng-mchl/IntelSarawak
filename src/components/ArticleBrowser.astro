---
import { articles, slugFor } from "../lib/articles";

interface Props {
  // Number of most-recent articles to leave out (e.g. already shown in a
  // featured section above this one).
  skip?: number;
}

const { skip = 0 } = Astro.props;

// Every article goes to the client; `featured` marks the ones already shown
// above. They're hidden from the unfiltered list but reappear once a filter
// is active, so clicking a calendar day never comes up empty for them.
const payload = articles.map((a, i) => ({
  slug: slugFor(a),
  title: a.title,
  date: a.date,
  summary: a.summary,
  image_url: a.image_url,
  category: a.category,
  featured: i < skip,
}));
---

<div>
	<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
		<div class="flex flex-wrap items-center gap-3">
			<p id="results-count" class="text-sm font-medium text-slate-500 dark:text-slate-400"></p>
			<button
				id="clear-filters"
				type="button"
				hidden
				class="rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600 transition hover:border-brand-300 hover:text-brand-600 dark:border-slate-800 dark:text-slate-400 dark:hover:border-brand-700 dark:hover:text-brand-400"
			>
				Clear filters ✕
			</button>
		</div>

		<div class="inline-flex rounded-lg border border-slate-200 bg-white p-1 dark:border-slate-800 dark:bg-black">
			<button
				id="view-grid-btn"
				type="button"
				aria-label="Grid view"
				class="view-toggle-btn rounded-md p-2 transition"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
					<rect x="3" y="3" width="8" height="8" rx="1.5"></rect>
					<rect x="13" y="3" width="8" height="8" rx="1.5"></rect>
					<rect x="3" y="13" width="8" height="8" rx="1.5"></rect>
					<rect x="13" y="13" width="8" height="8" rx="1.5"></rect>
				</svg>
			</button>
			<button
				id="view-table-btn"
				type="button"
				aria-label="Table view"
				class="view-toggle-btn rounded-md p-2 transition"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
					<rect x="3" y="4.5" width="18" height="3.5" rx="1"></rect>
					<rect x="3" y="10.25" width="18" height="3.5" rx="1"></rect>
					<rect x="3" y="16" width="18" height="3.5" rx="1"></rect>
				</svg>
			</button>
		</div>
	</div>

	<div id="articles-container"></div>

	<nav id="pagination" aria-label="Pagination" class="mt-10 flex items-center justify-center gap-1.5"></nav>
</div>

<script type="application/json" id="articles-data" set:html={JSON.stringify(payload)} />

<style>
	.view-toggle-btn {
		color: var(--color-slate-500);
	}
	:global(.dark) .view-toggle-btn {
		color: var(--color-slate-400);
	}
	.view-toggle-btn.active {
		background-color: var(--color-brand-600);
		color: white;
	}
	:global(.dark) .view-toggle-btn.active {
		background-color: var(--color-brand-500);
		color: black;
	}
</style>

<script>
	import { categoryMeta } from "../lib/categories";
	import { dayKey, getFilter, loadArticles, setFilter, subscribe, type ArticleStub } from "../lib/filterState";

	const allArticles: ArticleStub[] = loadArticles();

	const PAGE_SIZE = 9;
	const VIEW_KEY = "sarawak-stem-view";

	const container = document.getElementById("articles-container")!;
	const pagination = document.getElementById("pagination")!;
	const resultsCount = document.getElementById("results-count")!;
	const clearBtn = document.getElementById("clear-filters")!;
	const gridBtn = document.getElementById("view-grid-btn")!;
	const tableBtn = document.getElementById("view-table-btn")!;

	let view: "grid" | "table" = localStorage.getItem(VIEW_KEY) === "table" ? "table" : "grid";
	let page = 1;
	let articles: ArticleStub[] = [];

	function formatDate(iso: string): string {
		return new Date(iso).toLocaleDateString("en-MY", {
			day: "numeric",
			month: "short",
			year: "numeric",
			timeZone: "Asia/Kuching",
		});
	}

	function categoryBadge(category: string): HTMLElement {
		const meta = categoryMeta(category);
		return el(
			"span",
			{ class: `inline-flex w-fit items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${meta.badge}` },
			meta.label,
		);
	}

	function applyFilter(): ArticleStub[] {
		const f = getFilter();
		const filtering = Boolean(f.category || f.date);
		return allArticles.filter(
			(a) =>
				(filtering || !a.featured) &&
				(!f.category || a.category === f.category) &&
				(!f.date || dayKey(a.date) === f.date),
		);
	}

	function el<K extends keyof HTMLElementTagNameMap>(
		tag: K,
		attrs: Record<string, string> = {},
		...children: (Node | string)[]
	): HTMLElementTagNameMap[K] {
		const node = document.createElement(tag);
		for (const [key, value] of Object.entries(attrs)) {
			if (key === "class") node.className = value;
			else node.setAttribute(key, value);
		}
		for (const child of children) {
			node.append(child);
		}
		return node;
	}

	function thumbnail(a: ArticleStub, extraClass: string): HTMLElement {
		if (a.image_url) {
			return el("img", {
				src: a.image_url,
				alt: "",
				loading: "lazy",
				referrerpolicy: "no-referrer",
				class: `${extraClass} object-cover`,
			});
		}
		// No source image -- keep layout consistent with a plain placeholder
		// rather than hotlinking nothing and leaving a broken image icon.
		return el("div", {
			class: `${extraClass} bg-gradient-to-br from-brand-50 to-slate-100 dark:from-slate-900 dark:to-black`,
		});
	}

	function viewArticleButton(slug: string, extraClass: string): HTMLAnchorElement {
		return el(
			"a",
			{
				href: `/articles/${slug}/`,
				class: `inline-flex w-fit items-center gap-1 rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-brand-700 dark:bg-brand-500 dark:text-black dark:hover:bg-brand-400 ${extraClass}`,
			},
			"View article",
		);
	}

	function renderGrid(items: ArticleStub[]): HTMLElement {
		const grid = el("div", { class: "grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-3" });
		for (const a of items) {
			const card = el(
				"div",
				{
					class:
						"flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-brand-200 hover:shadow-md dark:border-slate-800 dark:bg-black dark:hover:border-brand-800",
				},
				thumbnail(a, "aspect-[3/2] w-full"),
				el(
					"div",
					{ class: "flex flex-1 flex-col p-7" },
					el("div", { class: "flex flex-wrap items-center justify-between gap-2" }, el("time", { class: "text-xs font-medium tracking-wide text-slate-400 uppercase dark:text-slate-500" }, formatDate(a.date)), categoryBadge(a.category)),
					el("h2", { class: "font-display mt-2 text-xl leading-snug font-semibold text-slate-900 dark:text-slate-100" }, a.title),
					el("p", { class: "mt-3 line-clamp-4 flex-1 text-sm text-slate-600 dark:text-slate-400" }, a.summary),
					viewArticleButton(a.slug, "mt-5"),
				),
			);
			grid.append(card);
		}
		return grid;
	}

	function renderTable(items: ArticleStub[]): HTMLElement {
		const wrapper = el("div", {
			class: "overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-black",
		});
		const table = el("table", { class: "w-full text-left text-sm" });
		const thead = el(
			"thead",
			{ class: "border-b border-slate-200 text-xs tracking-wide text-slate-400 uppercase dark:border-slate-800 dark:text-slate-500" },
			el(
				"tr",
				{},
				el("th", { class: "px-5 py-3 font-medium" }, "Date"),
				el("th", { class: "px-5 py-3 font-medium" }, "Title"),
				el("th", { class: "px-5 py-3 font-medium" }, ""),
			),
		);
		const tbody = el("tbody", { class: "divide-y divide-slate-100 dark:divide-slate-900" });
		for (const a of items) {
			const row = el(
				"tr",
				{ class: "align-top" },
				el(
					"td",
					{ class: "w-32 px-5 py-4 whitespace-nowrap text-slate-400 dark:text-slate-500" },
					formatDate(a.date),
				),
				el(
					"td",
					{ class: "px-5 py-4" },
					el(
						"div",
						{ class: "flex items-start gap-3" },
						thumbnail(a, "h-14 w-20 shrink-0 rounded-md"),
						el(
							"div",
							{},
							categoryBadge(a.category),
								el("p", { class: "font-display mt-1.5 font-semibold text-slate-900 dark:text-slate-100" }, a.title),
							el("p", { class: "mt-1 line-clamp-2 text-slate-500 dark:text-slate-400" }, a.summary),
						),
					),
				),
				el("td", { class: "px-5 py-4 text-right" }, viewArticleButton(a.slug, "")),
			);
			tbody.append(row);
		}
		table.append(thead, tbody);
		wrapper.append(table);
		return wrapper;
	}

	function pageButton(label: string, targetPage: number, opts: { active?: boolean; disabled?: boolean } = {}): HTMLButtonElement {
		const base = "min-w-9 rounded-md px-3 py-1.5 text-sm font-medium transition";
		const state = opts.active
			? "bg-brand-600 text-white dark:bg-brand-500 dark:text-black"
			: opts.disabled
				? "cursor-not-allowed text-slate-300 dark:text-slate-700"
				: "text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-900";
		const btn = el("button", { type: "button", class: `${base} ${state}` }, label);
		if (opts.disabled) btn.setAttribute("disabled", "true");
		btn.addEventListener("click", () => setPage(targetPage));
		return btn;
	}

	function renderPagination(totalPages: number) {
		pagination.replaceChildren();
		if (totalPages <= 1) return;

		pagination.append(pageButton("Prev", page - 1, { disabled: page === 1 }));
		for (let p = 1; p <= totalPages; p++) {
			pagination.append(pageButton(String(p), p, { active: p === page }));
		}
		pagination.append(pageButton("Next", page + 1, { disabled: page === totalPages }));
	}

	function render() {
		articles = applyFilter();
		const totalPages = Math.max(1, Math.ceil(articles.length / PAGE_SIZE));
		page = Math.min(Math.max(1, page), totalPages);

		const start = (page - 1) * PAGE_SIZE;
		const items = articles.slice(start, start + PAGE_SIZE);

		if (items.length === 0) {
			container.replaceChildren(
				el(
					"p",
					{ class: "rounded-xl border border-dashed border-slate-300 py-16 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400" },
					"No articles match these filters.",
				),
			);
		} else {
			container.replaceChildren(view === "grid" ? renderGrid(items) : renderTable(items));
		}
		renderPagination(totalPages);

		const f = getFilter();
		const filtering = Boolean(f.category || f.date);
		clearBtn.hidden = !filtering;
		const noun = `article${articles.length === 1 ? "" : "s"}`;
		resultsCount.textContent = filtering
			? `${articles.length} ${noun} match${articles.length === 1 ? "es" : ""}${f.date ? ` on ${formatDate(`${f.date}T00:00:00+08:00`)}` : ""} · page ${page} of ${totalPages}`
			: `${articles.length} ${noun} curated · page ${page} of ${totalPages}`;

		gridBtn.classList.toggle("active", view === "grid");
		tableBtn.classList.toggle("active", view === "table");
	}

	function setPage(next: number) {
		page = next;
		render();
	}

	function setView(next: "grid" | "table") {
		view = next;
		page = 1;
		localStorage.setItem(VIEW_KEY, view);
		render();
	}

	gridBtn.addEventListener("click", () => setView("grid"));
	tableBtn.addEventListener("click", () => setView("table"));
	clearBtn.addEventListener("click", () => setFilter({ category: null, date: null }));

	// subscribe() fires immediately, which also does the initial render.
	subscribe(() => {
		page = 1;
		render();
	});
</script>
