---
import { articles, formatDate, slugFor } from "../lib/articles";

const [highlight, ...rest] = articles;
const reel = rest.slice(0, 3);
---

{highlight && (
	<section class="bg-slate-100 dark:bg-slate-950">
		<div class="mx-auto max-w-6xl px-6 pt-12 pb-16">
			<h2 class="font-display mb-8 text-lg font-semibold tracking-tight text-slate-700 dark:text-slate-300">
				Featured
			</h2>
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
				<a
					href={`/articles/${slugFor(highlight)}/`}
					class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-brand-200 hover:shadow-md lg:col-span-2 dark:border-slate-800 dark:bg-black dark:hover:border-brand-800"
				>
					{highlight.image_url ? (
						<img
							src={highlight.image_url}
							alt=""
							loading="eager"
							referrerpolicy="no-referrer"
							class="aspect-[3/1] w-full object-cover"
						/>
					) : (
						<div class="aspect-[3/1] w-full bg-gradient-to-br from-brand-50 to-slate-100 dark:from-slate-900 dark:to-black" />
					)}
					<div class="flex flex-1 flex-col p-4 sm:p-5">
						<time datetime={highlight.date} class="text-xs font-medium tracking-wide text-slate-400 uppercase dark:text-slate-500">
							{formatDate(highlight.date)}
						</time>
						<h3 class="font-display mt-2 text-xl leading-snug font-semibold text-slate-900 group-hover:text-brand-700 sm:text-2xl dark:text-slate-100 dark:group-hover:text-brand-400">
							{highlight.title}
						</h3>
						<p class="mt-3 line-clamp-2 flex-1 text-base text-slate-600 dark:text-slate-400">
							{highlight.summary}
						</p>
						<span class="mt-3 inline-flex w-fit items-center gap-1 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition group-hover:bg-brand-700 dark:bg-brand-500 dark:text-black dark:group-hover:bg-brand-400">
							View article
						</span>
					</div>
				</a>

				<div class="grid grid-cols-3 gap-3 lg:flex lg:flex-col lg:gap-3">
					{reel.map((a) => (
						<a
							href={`/articles/${slugFor(a)}/`}
							class="group flex flex-1 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-brand-200 hover:shadow-md dark:border-slate-800 dark:bg-black dark:hover:border-brand-800"
						>
							{a.image_url ? (
								<img
									src={a.image_url}
									alt=""
									loading="lazy"
									referrerpolicy="no-referrer"
									class="aspect-square w-full object-cover lg:aspect-[3/1]"
								/>
							) : (
								<div class="aspect-square w-full bg-gradient-to-br from-brand-50 to-slate-100 lg:aspect-[3/1] dark:from-slate-900 dark:to-black" />
							)}
							<div class="flex flex-1 flex-col p-2 sm:p-4 lg:p-3">
								<time datetime={a.date} class="text-[10px] font-medium tracking-wide text-slate-400 uppercase sm:text-xs dark:text-slate-500">
									{formatDate(a.date)}
								</time>
								<h3 class="font-display mt-1 line-clamp-2 text-xs leading-snug font-semibold text-slate-900 group-hover:text-brand-700 sm:text-base lg:line-clamp-1 dark:text-slate-100 dark:group-hover:text-brand-400">
									{a.title}
								</h3>
							</div>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>
)}
