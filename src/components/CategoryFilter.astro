---
import { articles } from "../lib/articles";
import { CATEGORY_ORDER, CATEGORY_META } from "../lib/categories";

const total = articles.length;
const cards = CATEGORY_ORDER.map((key) => {
  const count = articles.filter((a) => a.category === key).length;
  return { key, count, share: total ? (count / total) * 100 : 0, ...CATEGORY_META[key] };
});
---

<div class="flex h-full min-w-0 flex-col">
	<h3 class="font-display text-lg font-semibold text-slate-800 dark:text-slate-200">Browse by category</h3>
	<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
		Pick a category to filter the list and recolour the calendar.
	</p>

	<div class="mt-4 grid flex-1 grid-cols-2 grid-rows-3 gap-4">
		<button type="button" data-cat="" class="cat-card flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 text-left transition dark:border-slate-800 dark:bg-black">
			<span class="flex items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
				<span class="h-2.5 w-2.5 rounded-full bg-brand-500"></span>
				All
			</span>
			<span class="font-display block text-4xl font-semibold text-slate-900 dark:text-slate-100">{total}</span>
			<span class="block h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-900">
				<span class="block h-full w-full rounded-full bg-brand-400 dark:bg-brand-500"></span>
			</span>
		</button>

		{cards.map((c) => (
			<button type="button" data-cat={c.key} class="cat-card flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 text-left transition dark:border-slate-800 dark:bg-black">
				<span class="flex items-center gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
					<span class={`h-2.5 w-2.5 rounded-full ${c.dot}`}></span>
					{c.label}
				</span>
				<span class="font-display block text-4xl font-semibold text-slate-900 dark:text-slate-100">{c.count}</span>
				<span class="block h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-900">
					<span class={`block h-full rounded-full ${c.bar}`} style={`width: ${c.share}%`}></span>
				</span>
			</button>
		))}
	</div>
</div>

<style>
	.cat-card:hover {
		border-color: var(--color-brand-300);
	}
	:global(.dark) .cat-card:hover {
		border-color: var(--color-brand-700);
	}
	.cat-card.active {
		border-color: var(--color-brand-600);
		box-shadow: 0 0 0 1px var(--color-brand-600);
	}
	:global(.dark) .cat-card.active {
		border-color: var(--color-brand-400);
		box-shadow: 0 0 0 1px var(--color-brand-400);
	}
</style>

<script>
	import { getFilter, setFilter, subscribe } from "../lib/filterState";

	const cards = Array.from(document.querySelectorAll<HTMLButtonElement>(".cat-card"));

	cards.forEach((card) => {
		card.addEventListener("click", () => {
			const key = card.dataset.cat || null;
			// Clicking the active category again returns to "All".
			setFilter({ category: getFilter().category === key ? null : key });
		});
	});

	subscribe((f) => {
		cards.forEach((card) => {
			const key = card.dataset.cat || null;
			card.classList.toggle("active", key === f.category);
		});
	});
</script>
