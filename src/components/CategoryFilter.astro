---
import { CATEGORY_ORDER, CATEGORY_META } from "../lib/categories";

const items = CATEGORY_ORDER.map((key) => ({ key, ...CATEGORY_META[key] }));
const itemClass =
  "cat-seg-item relative z-10 flex flex-1 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-semibold whitespace-nowrap text-slate-500 transition-colors dark:text-slate-400";
---

<!-- iOS-style segmented control: one rounded track, a sliding "thumb" behind the active item. -->
<div
	class="cat-seg relative flex overflow-x-auto rounded-2xl bg-slate-100 p-1.5 dark:bg-slate-900"
	role="group"
	aria-label="Filter by category"
>
	<span class="cat-seg-thumb pointer-events-none absolute top-1.5 bottom-1.5 left-0 w-0 rounded-xl bg-white opacity-0 shadow-sm ring-1 ring-black/5 dark:bg-slate-700 dark:ring-white/10"></span>

	<button type="button" data-cat="" class={itemClass}>
		<span class="h-2 w-2 shrink-0 rounded-full bg-brand-500"></span>
		All
	</button>

	{items.map((item) => (
		<button type="button" data-cat={item.key} class={itemClass}>
			<span class={`h-2 w-2 shrink-0 rounded-full ${item.dot}`}></span>
			{item.label}
		</button>
	))}
</div>

<style>
	.cat-seg {
		scrollbar-width: none;
	}
	.cat-seg::-webkit-scrollbar {
		display: none;
	}
	.cat-seg-thumb {
		transition:
			left 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 0.2s ease;
	}
	.cat-seg-item:hover:not(.active) {
		color: var(--color-slate-800);
	}
	:global(.dark) .cat-seg-item:hover:not(.active) {
		color: var(--color-slate-100);
	}
	.cat-seg-item.active {
		color: var(--color-slate-900);
	}
	:global(.dark) .cat-seg-item.active {
		color: var(--color-white);
	}
	@media (prefers-reduced-motion: reduce) {
		.cat-seg-thumb {
			transition: none;
		}
	}
</style>

<script>
	import { getFilter, setFilter, subscribe } from "../lib/filterState";

	const track = document.querySelector<HTMLElement>(".cat-seg")!;
	const thumb = track.querySelector<HTMLElement>(".cat-seg-thumb")!;
	const items = Array.from(track.querySelectorAll<HTMLButtonElement>(".cat-seg-item"));

	function moveThumb(animate: boolean) {
		const activeItem = items.find((i) => i.classList.contains("active"));
		if (!activeItem) return;
		if (!animate) thumb.style.transition = "none";
		thumb.style.left = `${activeItem.offsetLeft}px`;
		thumb.style.width = `${activeItem.offsetWidth}px`;
		thumb.style.opacity = "1";
		if (!animate) {
			void thumb.offsetWidth; // apply without the slide
			thumb.style.transition = "";
		} else {
			activeItem.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
		}
	}

	items.forEach((item) => {
		item.addEventListener("click", () => {
			const key = item.dataset.cat || null;
			// Clicking the active category again returns to "All".
			setFilter({ category: getFilter().category === key ? null : key });
		});
	});

	let first = true;
	subscribe((f) => {
		items.forEach((item) => {
			const on = (item.dataset.cat || null) === f.category;
			item.classList.toggle("active", on);
			item.setAttribute("aria-pressed", String(on));
		});
		moveThumb(!first);
		first = false;
	});

	// Widths change with fonts loading and with the window, so re-fit the thumb.
	new ResizeObserver(() => moveThumb(false)).observe(track);
</script>
