---
import Layout from "../layouts/Layout.astro";
import ArticleBrowser from "../components/ArticleBrowser.astro";
import ActivityCalendar from "../components/ActivityCalendar.astro";
import CategoryFilter from "../components/CategoryFilter.astro";
---

<Layout title="Overview — IntelSarawak" description="Explore STEM developments in Sarawak by day and category.">
	<section class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-black">
		<div class="mx-auto max-w-6xl px-6 py-10">
			<h1 class="font-display text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100">
				Overview
			</h1>
			<p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
				See when STEM stories appeared, filter them by category, and dig into any day.
			</p>
		</div>
	</section>

	<section class="bg-white dark:bg-black">
		<div class="mx-auto max-w-6xl px-6 pt-12 pb-16">
			<div class="mb-14 grid grid-cols-1 items-stretch gap-8 lg:grid-cols-[auto_minmax(0,1fr)] lg:gap-10">
				<ActivityCalendar />
				<CategoryFilter />
			</div>

			<h2 class="font-display mb-8 text-lg font-semibold tracking-tight text-slate-700 dark:text-slate-300">
				All STEM activities
			</h2>
			<ArticleBrowser />
		</div>
	</section>
</Layout>
